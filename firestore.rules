rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function encrypted(d) {
      return d.keys().hasAll(['v','nonce','ciphertext','mac'])
        && d.keys().hasOnly(['v','nonce','ciphertext','mac'])
        && d.v == 1 && d.nonce is string && d.nonce.size() == 16
        && d.mac is string && d.mac.size() == 24
        && d.ciphertext is string && d.ciphertext.size() > 0 && d.ciphertext.size() <= 16384;
    }
    match /users/{userId}/vault/{vaultId} {
      allow get, delete: if request.auth != null && request.auth.uid == userId && vaultId == 'config';
      allow create: if request.auth != null && request.auth.uid == userId && vaultId == 'config' && encrypted(request.resource.data);
      allow update, list: if false;
    }
    // No client profile fields are currently used. Prevent arbitrary role/claim fields.
    match /users/{userId} {
      allow get, delete: if request.auth != null && request.auth.uid == userId;
      allow list, create, update: if false;
    }

    // User expense and income transactions
    match /users/{userId}/expenses/{expenseId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasAll(['title', 'category', 'amountCents', 'date', 'note'])
          && d.keys().hasOnly(['title', 'category', 'amountCents', 'date', 'note', 'type'])
          && d.title is string && d.title.size() > 0 && d.title.size() <= 80
          && (d.get('type', 'expense') in ['expense', 'income'])
          && ((d.get('type', 'expense') == 'expense' && d.category in ['Food', 'Transport', 'Shopping', 'Bills', 'Health', 'Education', 'Other'])
            || (d.get('type', 'expense') == 'income' && d.category in ['Salary', 'Freelance', 'Allowance', 'Gift', 'Refund', 'Opening balance', 'Other income']))
          && d.amountCents is int && d.amountCents > 0 && d.amountCents <= 99999999999
          && d.date is timestamp && d.note is string && d.note.size() <= 300;
      }

      allow read, delete: if owner();
      allow create, update: if owner() && (
        (exists(/databases/$(database)/documents/users/$(userId)/vault/config) && encrypted(request.resource.data))
        || (!exists(/databases/$(database)/documents/users/$(userId)/vault/config) && valid())
      );
    }
  }
}
